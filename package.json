{
	"name": "ts-dev-server",
	"displayName": "ts-dev-server",
	"description": "Dev server for TypeScript projects",
	"version": "0.1.0",
	"engines": {
		"vscode": "^1.85.0"
	},
	"publisher": "extremebasic",
	"repository": {
		"type": "git",
		"url": "https://github.com/andrew24601/ts-dev-server"
	},
	"license": "BSD-3-Clause",
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension.js",
	"contributes": {
		"configuration": [
			{
				"title": "ts dev server",
				"properties": {
					"tsdevserver.port": {
						"type": "number",
						"default": 8080,
						"description": "Port for the server to use",
						"scope": "application"
					},
					"tsdevserver.host": {
						"type": "string",
						"default": "localhost",
						"description": "Host for the server to use, 0.0.0.0 to be public",
						"scope": "application"
					}
				}
			}
		],
		"commands": [
			{
				"command": "tsdevserver.toggleServer",
				"title": "Toggle Dev Server",
				"category": "ts dev server"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "yarn run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"lint": "eslint src",
		"pretest": "yarn run compile && yarn run lint",
		"test": "node ./out/test/runTest.js",
		"package": "vsce package"
	},
	"devDependencies": {
		"@eslint/js": "^9.0.0",
		"@types/mocha": "^10.0.0",
		"@types/node": "^20.0.0",
		"@types/vscode": "^1.85.0",
		"@vscode/test-electron": "^2.4.0",
		"@vscode/vsce": "^3.0.0",
		"eslint": "^9.0.0",
		"mocha": "^10.0.0",
		"typescript": "^5.4.0",
		"typescript-eslint": "^8.0.0"
	},
	"dependencies": {
		"lines-and-columns": "^1.1.6",
		"ts-debug-reload-server": "^0.0.37"
	}
}
